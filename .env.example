DATABASE_URL="file:./dev.db"
# Hosted Turso database instead (set automatically by Vercel's Turso integration):
# TURSO_DATABASE_URL="libsql://<db>.turso.io"
# TURSO_AUTH_TOKEN=""

# Auth — generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Optional Google login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI: "ollama" (local) or "google" (AI Studio API)
AI_PROVIDER="ollama"
AI_MODEL="gemma3"            # google: e.g. gemma-4-26b-a4b-it or a gemini model
OLLAMA_URL="http://localhost:11434"
GOOGLE_AI_API_KEY=""
# Live voice interviews (/interview/live) need AI_PROVIDER="google". Optional model override:
# LIVE_MODEL="gemini-3.8-live"

# Run Java / C# workshop tests in Docker on this machine (see README). Leave empty to disable.
CODE_RUNNER=""
